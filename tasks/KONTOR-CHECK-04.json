{
  "apiVersion": "hackfleet/v1",
  "kind": "Task",
  "metadata": {
    "id": "KONTOR-CHECK-04",
    "title": "Verify approval recovery and final application bundle",
    "parent": "KONTOR-RECOVERY-01"
  },
  "spec": {
    "objective": "Verify final integrated recovery code, independent adversarial tests, UI typecheck and production bundle on exact published source. Dependencies are disposable and all npm commands use an external cache; source remains protected.",
    "role": {
      "profession": "Integration tester",
      "memoryProfile": "task"
    },
    "runtime": {
      "preference": "github-actions",
      "allowed": [
        "github-actions"
      ]
    },
    "capabilities": {
      "required": [
        "shell",
        "node",
        "deterministic",
        "tests",
        "build"
      ],
      "optional": []
    },
    "context": {
      "include": [],
      "dependencySummaries": []
    },
    "skills": [],
    "writeScope": {
      "allowed": [
        "node_modules/**",
        "dist/**"
      ],
      "forbidden": [
        "src/**",
        "server/**",
        "chain/**",
        "programs/**",
        "tests/**",
        ".github/**"
      ]
    },
    "acceptance": [
      "All independent service/client tests pass",
      "UI typecheck and production bundle succeed",
      "Exact source commit and genuine worker receipt retained"
    ],
    "verification": {
      "commands": [
        "npm ci --ignore-scripts --no-audit --no-fund --cache /tmp/kontor-npm-cache",
        "npm --cache /tmp/kontor-npm-cache test",
        "npm --cache /tmp/kontor-npm-cache run build",
        "node -e \"require('node:fs').rmSync('node_modules',{recursive:true,force:true})\""
      ]
    },
    "deliverables": [
      "result-json"
    ],
    "limits": {
      "executionMinutes": 15,
      "retries": 1,
      "maxModelTurns": 1
    }
  }
}