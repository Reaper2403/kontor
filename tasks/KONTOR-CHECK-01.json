{
  "apiVersion": "hackfleet/v1",
  "kind": "Task",
  "metadata": {
    "id": "KONTOR-CHECK-01",
    "title": "Verify integrated UI and service at published source",
    "parent": "KONTOR-BUILD-20260930"
  },
  "spec": {
    "objective": "Run independent invariant tests and production build on exact published source. This gate covers service/client and UI packaging, not SBF execution or live devnet.",
    "role": {
      "profession": "Integration tester",
      "memoryProfile": "task"
    },
    "runtime": {
      "preference": "github-actions",
      "allowed": [
        "github-actions"
      ]
    },
    "capabilities": {
      "required": [
        "shell",
        "node",
        "deterministic",
        "tests",
        "build"
      ],
      "optional": []
    },
    "context": {
      "include": [],
      "dependencySummaries": []
    },
    "skills": [],
    "writeScope": {
      "allowed": [
        "node_modules/**",
        "dist/**"
      ],
      "forbidden": [
        "src/**",
        "server/**",
        "chain/**",
        "programs/**",
        "tests/**",
        ".github/**"
      ]
    },
    "acceptance": [
      "All independent service/client tests pass",
      "UI typecheck and production bundle succeed",
      "Exact source commit and genuine worker receipt retained"
    ],
    "verification": {
      "commands": [
        "npm ci --ignore-scripts --no-audit --no-fund",
        "npm test",
        "npm run build"
      ]
    },
    "deliverables": [
      "result-json"
    ],
    "limits": {
      "executionMinutes": 15,
      "retries": 1,
      "maxModelTurns": 1
    }
  }
}